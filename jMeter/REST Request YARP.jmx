      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HTTP Request YARP">
          <stringProp name="HTTPSampler.domain">192.168.232.95</stringProp>
          <stringProp name="HTTPSampler.port">5000</stringProp>
          <stringProp name="HTTPSampler.path">/users-service/api/Users</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;hey&quot;:&quot;yo&quot;, &quot;two&quot;: 2}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">SessionID</stringProp>
                <stringProp name="Header.value">test-session-1</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
        </hashTree>
        <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper

// Получаем тело ответа как строку
def response = prev.getResponseDataAsString()

// Парсим JSON
def json = new JsonSlurper().parseText(response)

// Проверяем, есть ли поле &quot;success&quot; и равно ли оно true
if (json.success == true) {
    // Явно помечаем успех (хотя JMeter делает это по умолчанию)
    AssertionResult.setFailure(false)
} else {
    // Помечаем ошибку, если &quot;success&quot;: true не найден
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;&quot;success&quot;: true not found in JSON response&apos;)
}
</stringProp>
        </JSR223Assertion>
        <hashTree/>
      </hashTree>
